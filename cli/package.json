{
  "name": "@yousufaltayeb/openwhisper-client",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "bin": {
    "openwhisper": "./src/main.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "protocol:generate": "bun run ../scripts/generate-protocol-types.ts",
    "build:host": "bun --config=build.bunfig.toml --no-env-file build --compile --env=disable --outfile dist/openwhisper src/main.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "bun-types": "1.3.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
